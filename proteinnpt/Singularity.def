Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ pyproject.toml uv.lock README.md patch_upstream.py \
        ${SINGULARITY_ROOTFS}/opt/program/

%post
    apt-get update && apt-get install -y git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    cd /opt/program
    uv sync --no-cache

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output

    # upstream's Trainer is GPU-only and its on-the-fly embedding path is broken
    # for ProteinNPT; both are patched here and fail loudly if upstream changes
    uv run --no-sync python patch_upstream.py

    # frozen ESM-2 650M embedder (fair-esm .pt, loaded by upstream's vendored ESM)
    mkdir -p /opt/program/data
    curl -fL --retry 3 --retry-delay 5 \
        https://dl.fbaipublicfiles.com/fair-esm/models/esm2_t33_650M_UR50D.pt \
        -o /opt/program/data/esm2_t33_650M_UR50D.pt

%environment
    export PATH="/opt/program/.venv/bin:$PATH"
    # upstream imports wandb unconditionally; args.use_wandb is false, and this
    # keeps it from reaching the network even if that changes
    export WANDB_MODE=disabled
    export WANDB_SILENT=true
    export HF_HUB_OFFLINE=1

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
