Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ pyproject.toml uv.lock README.md ${SINGULARITY_ROOTFS}/opt/program/

%post
    # clustalo: only used for indel + inference-time-retrieval scoring
    apt-get update && apt-get install -y git curl ca-certificates build-essential clustalo && rm -rf /var/lib/apt/lists/*

    # install uv (defaults to /root/.local/bin)
    curl -LsSf https://astral.sh/uv/install.sh | sh

    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    # sync dependencies
    cd /opt/program
    uv sync --no-cache

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output
    # fetch the default (Small) checkpoint (add sizes here to use another checkpoint_size)
    for size in Small; do
        mkdir -p /opt/program/data/$size
        for f in config.json pytorch_model.bin; do
            curl -fL https://huggingface.co/OATML-Markslab/Tranception_$size/resolve/main/$f \
                -o /opt/program/data/$size/$f || exit 1
        done
    done

%environment
    export PATH="/opt/program/.venv/bin:$PATH"

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
