Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r pyproject.toml uv.lock README.md ${SINGULARITY_ROOTFS}/opt/program/

%post
    # C compiler needed by triton to JIT-compile its CUDA kernels at runtime
    apt-get update && apt-get install -y git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*

    # install uv (defaults to /root/.local/bin)
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # move binaries to a globally accessible system path
    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    # sync dependencies
    cd /opt/program
    uv sync --no-cache

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output
    # checkpoint referenced by model_file_path in the model card
    mkdir -p /opt/program/data
    curl -L https://files.ipd.uw.edu/pub/ligandmpnn/proteinmpnn_v_48_020.pt \
        -o /opt/program/data/proteinmpnn_v_48_020.pt

%environment
    export PATH="/opt/program/.venv/bin:$PATH"

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
