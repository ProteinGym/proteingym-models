Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ pyproject.toml uv.lock README.md .python-version LICENSE \
        ${SINGULARITY_ROOTFS}/opt/program/

%post
    apt-get update && apt-get install -y git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    cd /opt/program
    uv sync --no-cache

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output

    # ESM-MSA-1b checkpoint. fair-esm's local loader requires the
    # contact-regression weights alongside it (every model except ESM-1v and
    # ESM-IF), so both are baked.
    mkdir -p /opt/program/data
    URL=https://dl.fbaipublicfiles.com/fair-esm
    curl -fL --retry 3 --retry-delay 5 $URL/models/esm_msa1b_t12_100M_UR50S.pt \
        -o /opt/program/data/esm_msa1b_t12_100M_UR50S.pt
    curl -fL --retry 3 --retry-delay 5 $URL/regression/esm_msa1b_t12_100M_UR50S-contact-regression.pt \
        -o /opt/program/data/esm_msa1b_t12_100M_UR50S-contact-regression.pt

    uv run --no-sync python -c "from proteingym.models.msa_transformer import model; print('msa_transformer.model import OK')"

%environment
    export PATH="/opt/program/.venv/bin:$PATH"

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
