Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ pyproject.toml uv.lock README.md LICENSE MODEL_LICENSE.md \
        ${SINGULARITY_ROOTFS}/opt/program/

%post
    # build-essential is not needed to compile this project's own dependencies
    # (torch resolves to a prebuilt wheel) - kept only because torch's triton
    # dependency JIT-compiles small C wrapper code at *runtime*
    apt-get update && apt-get install -y git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    cd /opt/program
    uv sync --no-cache

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output

    # PoET-2 checkpoint and its non-commercial model licence, from Zenodo. -f so
    # a refused download fails the build instead of baking an HTML error page as
    # weights
    mkdir -p /opt/program/data
    curl -fL --retry 3 --retry-delay 5 \
        "https://zenodo.org/records/16815645/files/poet-2.ckpt?download=1" \
        -o /opt/program/data/poet-2.ckpt
    curl -fL --retry 3 --retry-delay 5 \
        "https://zenodo.org/records/16815645/files/MODEL_LICENSE?download=1" \
        -o /opt/program/data/MODEL_LICENSE

%environment
    export PATH="/opt/program/.venv/bin:$PATH"

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
