Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ vendor/ pyproject.toml uv.lock README.md ${SINGULARITY_ROOTFS}/opt/program/

%post
    # build-essential only for triton's runtime C-wrapper JIT
    apt-get update && apt-get install -y git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*

    # install uv (defaults to /root/.local/bin)
    curl -LsSf https://astral.sh/uv/install.sh | sh

    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    # sync dependencies
    cd /opt/program
    uv sync --no-cache

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output
    # structure quantizer weights (GVP encoder + 2048-cluster k-means codebook)
    STATIC=/opt/program/src/proteingym/models/prosst/structure/static
    URL=https://github.com/ai4protein/ProSST/raw/13bd56495641a84cd5475eaef7aa98b14fdc6ed5/prosst/structure/static
    mkdir -p $STATIC
    curl -fL $URL/AE.pt -o $STATIC/AE.pt
    curl -fL $URL/2048.joblib -o $STATIC/2048.joblib

    # ProSST-2048 checkpoint (incl. trust_remote_code modeling files) for offline use
    mkdir -p /opt/program/data
    uv run --no-sync hf download AI4Protein/ProSST-2048 \
        --revision e94ffee7846d7f55c1bf5efa8ec7372a336ac4b8 \
        --local-dir /opt/program/data/ProSST-2048

%environment
    export PATH="/opt/program/.venv/bin:$PATH"
    export HF_HUB_OFFLINE=1
    # trust_remote_code copies modeling files into HF_MODULES_CACHE, which must be writable
    export HF_MODULES_CACHE=/tmp/hf_modules_cache

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
