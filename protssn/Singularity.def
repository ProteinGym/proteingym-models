Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ pyproject.toml uv.lock README.md LICENSE ${SINGULARITY_ROOTFS}/opt/program/

%post
    # build-essential only for triton's runtime C-wrapper JIT
    apt-get update && apt-get install -y git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*

    # install uv (defaults to /root/.local/bin)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    cd /opt/program
    uv sync --no-cache

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output

    # EGNN checkpoint (148M parameters, ~592 MB) plus the normalization
    # statistics for every supported k
    mkdir -p /opt/program/data/norm
    uv run --no-sync hf download tyang816/ProtSSN protssn_k20_h512.pt \
        --revision cb2d622fb9b6d9c0b3bbf29f03f8f74a973dfb23 \
        --local-dir /opt/program/data
    test -s /opt/program/data/protssn_k20_h512.pt
    for k in 10 20 30; do
        curl -fL --retry 3 --retry-delay 5 \
            https://raw.githubusercontent.com/tyang816/ProtSSN/9da358e2d5b3ac17e4e1874cc70ae17f67ae7b0f/norm/cath_k${k}_mean_attr.pt \
            -o /opt/program/data/norm/cath_k${k}_mean_attr.pt
        test -s /opt/program/data/norm/cath_k${k}_mean_attr.pt
    done

%environment
    export PATH="/opt/program/.venv/bin:$PATH"

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
