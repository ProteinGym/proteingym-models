Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ pyproject.toml uv.lock README.md .python-version LICENSE ${SINGULARITY_ROOTFS}/opt/program/
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program/data
    mkdir -p ${SINGULARITY_ROOTFS}/mnt/host-uv-cache

%post
    apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    export UV_CACHE_DIR=/mnt/host-uv-cache
    export UV_LOCK_TIMEOUT=1800

    cd /opt/program
    uv sync

    # the benchmark binds a host directory here for predictions;
    # apptainer cannot create a missing bind target inside the image
    mkdir -p /opt/program/output

    # MIF-ST is two checkpoints: the inverse-folding GNN and the CARP-640M
    # sequence model it transfers from. sequence_models fetches both through
    # torch.hub's cache - including CARP unconditionally, even when the GNN is
    # given as a local path - so pre-populate that cache and point TORCH_HOME
    # at it to keep the model offline at run time.
    export TORCH_HOME=/opt/program/data/torch
    mkdir -p $TORCH_HOME/hub/checkpoints
    cd $TORCH_HOME/hub/checkpoints
    curl -fL --retry 3 --retry-delay 5 \
        "https://zenodo.org/record/6573779/files/mifst.pt?download=1" -o mifst.pt
    curl -fL --retry 3 --retry-delay 5 \
        "https://zenodo.org/record/6564798/files/carp_640M.pt?download=1" -o carp_640M.pt
    [ "$(stat -c%s mifst.pt)" -gt 10000000 ]
    [ "$(stat -c%s carp_640M.pt)" -gt 2000000000 ]

    # proves both checkpoints are intact and resolve from the cache, not the network
    cd /opt/program
    uv run --no-sync python -c "\
from sequence_models.pretrained import load_model_and_alphabet; \
from proteingym.models.mif_st.model import MIFST; \
load_model_and_alphabet('mifst'); print('MIF-ST loads from cache OK')"

%environment
    export PATH="/opt/program/.venv/bin:$PATH"
    export TORCH_HOME=/opt/program/data/torch

%runscript
    cd /opt/program
    exec uv run --no-sync evedesign-proteingym "$@"
